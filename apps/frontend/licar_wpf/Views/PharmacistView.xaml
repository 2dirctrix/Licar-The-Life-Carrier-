<UserControl x:Class="licar_wpf.Views.PharmacistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:licar_wpf.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             Background="#F0F2F5" FontSize="14">
    <UserControl.Resources>
        <converters:StatusToKoreanConverter x:Key="StatusToKoreanConverter" />
        <converters:RecognitionToBrushConverter x:Key="RecognitionToBrushConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="15">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="약 운반 요청 목록" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding TransportList}" SelectedItem="{Binding SelectedTransport, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="요청 번호" Binding="{Binding TransportId}" Width="Auto"/>
                        <DataGridTextColumn Header="상태" Binding="{Binding Status, Converter={StaticResource StatusToKoreanConverter}}" Width="*"/>
                        <DataGridTextColumn Header="간호사" Binding="{Binding NurseName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15"
                    DataContext="{Binding TransportDetails}">
                <StackPanel>
                    <TextBlock Text="운반 상세 정보" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="요청 시간 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RequestedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="운반 시작 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SentTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="도착 시작 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArrivedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="2" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="현재 상태 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status, Converter={StaticResource StatusToKoreanConverter}}" Margin="2" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="로봇 번호 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RobotId}" Margin="2" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="담당 간호사 : " HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NurseName}" Margin="2" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="15">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="처방전 목록" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding PrescriptionList}" SelectedItem="{Binding SelectedPrescription, Mode=TwoWay}" VerticalAlignment="Stretch">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="처방전 번호" DisplayMemberBinding="{Binding PrescriptionId}" Width="auto"/>
                                <GridViewColumn Header="환자 이름" DisplayMemberBinding="{Binding PatientName}" Width="200"/>
                                <GridViewColumn Header="처방 날짜" DisplayMemberBinding="{Binding Date}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="15" >
                <!--Visibility="{Binding SelectedPrescription, Converter={StaticResource NullToVisibilityConverter}}">-->
                <StackPanel DataContext="{Binding PrescriptionDetails}">
                    <TextBlock Text="처방전 상세 정보" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="투약 기간 : " FontWeight="SemiBold" Margin="5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Period, StringFormat='{}{0} 일'}" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="환자 이름 : " FontWeight="SemiBold" Margin="5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PatientName}" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="복약 지도 : " FontWeight="SemiBold" Margin="5" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CounsellingNote}" TextWrapping="Wrap" Margin="5"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Margin="20,0,0,0" Background="White" CornerRadius="5" Padding="15" >
            <!--Visibility="{Binding PrescriptionDetails, Converter={StaticResource NullToVisibilityConverter}}">-->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="약 목록" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding DrugList}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Recognized}" Value="True" >
                                    <Setter Property="Background" Value="#DCFFDC" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Recognized}" Value="False" >
                                    <Setter Property="Background" Value="#FFDCDC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="약 이름" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="용량" Binding="{Binding Dosage}" Width="Auto"/>
                        <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>