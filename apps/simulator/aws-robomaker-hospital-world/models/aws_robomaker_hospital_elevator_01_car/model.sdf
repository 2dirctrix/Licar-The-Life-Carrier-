 <?xml version="1.0" ?>
  <sdf version="1.6">
    <model name="aws_robomaker_hospital_elevator_01_car">
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>1000.0</mass>
          <inertia>
            <ixx>100</ixx>
            <iyy>100</iyy>
            <izz>100</izz>
          </inertia>
        </inertial>
        <visual name="base_visual">
      <geometry>
        <box>
          <size>2.0 2.0 0.3</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>

    <collision name="base_collision">
      <geometry>
        <box>
          <size>2.0 2.0 0.3</size>
        </box>
      </geometry>
    </collision>

      </link>

      <link name="elevator_car">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>500.0</mass>
          <inertia>
            <ixx>50</ixx>
            <iyy>50</iyy>
            <izz>50</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://aws_robomaker_hospital_elevator_01_car/meshes/aws_robomaker_hospital_elevator_0
  1_car_visual.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://aws_robomaker_hospital_elevator_01_car/meshes/aws_robomaker_hospital_elevator_0
  1_car_collision.dae</uri>
            </mesh>
          </geometry>
        </collision>
      </link>

      <joint name="elevator_joint" type="prismatic">
        <parent>base_link</parent>
        <child>elevator_car</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>5</upper>
          </limit>
        </axis>
      </joint>

      <!-- ROS2 플러그인 -->
      <plugin name="elevator_joint_state" filename="libgazebo_ros_joint_state_publisher.so">       
        <ros>
          <namespace>/elevator</namespace>
        </ros>
        <update_rate>50</update_rate>
        <joint_name>elevator_joint</joint_name>
      </plugin>

      <plugin name="elevator_controller" filename="libgazebo_ros_joint_pose_trajectory.so">        
        <ros>
          <namespace>/elevator</namespace>
        </ros>
        <update_rate>50</update_rate>
      </plugin>

      <static>0</static>
    </model>
  </sdf>